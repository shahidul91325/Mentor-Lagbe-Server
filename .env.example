# ============================================================
# MentorLagbe Server — Environment Variables (example)
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ============================================================

# --- Server ---
PORT=5000
# Local dev: development. Production (Vercel): MUST be "production" so BetterAuth
# cookies use SameSite=None; Secure and are sent cross-origin by the frontend.
NODE_ENV=development

# Frontend origin allowed by CORS (no trailing slash).
# Local dev: http://localhost:3000  |  Production: https://mentor-lagbe-web.vercel.app
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB_NAME=mentor-lagbe

# --- BetterAuth ---
# Generate a secret: openssl rand -base64 32
# Local dev: http://localhost:5000  |  Production: https://mentor-lagbe-web-server.vercel.app
BETTER_AUTH_URL=http://localhost:5000

# --- JWT ---
# Generate a secret: openssl rand -hex 32
JWT_SECRET=

# --- ImgBB (image uploads: profile picture + tuition banner) ---
IMGBB_API_KEY=

# --- Stripe (Pro subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: recurring Price IDs created in the Stripe Dashboard.
# Student Pro = $10/month, Tutor Pro = $15/month.
# When unset, the server creates the matching inline price automatically.
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_STUDENT=
STRIPE_PRICE_ID_TUTOR=
